# ==============================================================================
# ClothStore — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your secure credentials:

# Telegram Bot Token (Secret — Server-side only, NEVER commit real tokens)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID for Store Order Notifications
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Firebase Project Configuration (Server-side runtime)
FIREBASE_PROJECT_ID=your_firebase_project_id_here
