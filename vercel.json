{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/product",
      "destination": "/frontend/product.html"
    },
    {
      "source": "/admin",
      "destination": "/dashboard/admin.html"
    },
    {
      "source": "/login",
      "destination": "/dashboard/login.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/admin.html"
    },
    {
      "source": "/dashboard/img/:path*",
      "destination": "/frontend/img/:path*"
    },
    {
      "source": "/product/img/:path*",
      "destination": "/frontend/img/:path*"
    },
    {
      "source": "/product/css/:path*",
      "destination": "/frontend/css/:path*"
    },
    {
      "source": "/product/js/:path*",
      "destination": "/frontend/js/:path*"
    },
    {
      "source": "/css/admin.css",
      "destination": "/dashboard/css/admin.css"
    },
    {
      "source": "/js/admin.js",
      "destination": "/dashboard/js/admin.js"
    },
    {
      "source": "/js/login.js",
      "destination": "/dashboard/js/login.js"
    },
    {
      "source": "/css/:path*",
      "destination": "/frontend/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/frontend/js/:path*"
    },
    {
      "source": "/img/:path*",
      "destination": "/frontend/img/:path*"
    }
  ]
}
