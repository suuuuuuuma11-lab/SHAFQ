{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/index"
    },
    {
      "source": "/index",
      "destination": "/frontend/index"
    },
    {
      "source": "/shop",
      "destination": "/frontend/shop"
    },
    {
      "source": "/about",
      "destination": "/frontend/about"
    },
    {
      "source": "/contact",
      "destination": "/frontend/contact"
    },
    {
      "source": "/product",
      "destination": "/frontend/product"
    },
    {
      "source": "/index.html",
      "destination": "/frontend/index"
    },
    {
      "source": "/shop.html",
      "destination": "/frontend/shop"
    },
    {
      "source": "/about.html",
      "destination": "/frontend/about"
    },
    {
      "source": "/contact.html",
      "destination": "/frontend/contact"
    },
    {
      "source": "/product.html",
      "destination": "/frontend/product"
    },
    {
      "source": "/admin",
      "destination": "/dashboard/admin"
    },
    {
      "source": "/login",
      "destination": "/dashboard/login"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/admin"
    },
    {
      "source": "/product/assets/:path*",
      "destination": "/frontend/assets/:path*"
    },
    {
      "source": "/product/data/:path*",
      "destination": "/frontend/data/:path*"
    },
    {
      "source": "/product/css/:path*",
      "destination": "/frontend/css/:path*"
    },
    {
      "source": "/product/js/:path*",
      "destination": "/frontend/js/:path*"
    },
    {
      "source": "/css/admin.css",
      "destination": "/dashboard/css/admin.css"
    },
    {
      "source": "/js/admin.js",
      "destination": "/dashboard/js/admin.js"
    },
    {
      "source": "/js/login.js",
      "destination": "/dashboard/js/login.js"
    },
    {
      "source": "/assets/:path*",
      "destination": "/frontend/assets/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "/frontend/data/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/frontend/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/frontend/js/:path*"
    }
  ]
}
