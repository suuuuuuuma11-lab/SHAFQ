{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/frontend/",
      "permanent": false
    },
    {
      "source": "/frontend",
      "destination": "/frontend/",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/dashboard/admin.html",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/admin.html",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "/dashboard/login.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard/img/:path*",
      "destination": "/frontend/img/:path*"
    },
    {
      "source": "/css/admin.css",
      "destination": "/dashboard/css/admin.css"
    },
    {
      "source": "/js/admin.js",
      "destination": "/dashboard/js/admin.js"
    },
    {
      "source": "/js/login.js",
      "destination": "/dashboard/js/login.js"
    },
    {
      "source": "/css/:path*",
      "destination": "/frontend/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/frontend/js/:path*"
    },
    {
      "source": "/img/:path*",
      "destination": "/frontend/img/:path*"
    }
  ]
}
