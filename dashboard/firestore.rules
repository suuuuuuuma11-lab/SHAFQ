rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // Role-Based Access Control:
    // Requires either custom claim (admin == true or role == 'admin')
    // OR registration in the dedicated 'admins' collection.
    // A normal authenticated user does NOT qualify as Admin.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Admins Collection ---
    // Stores authorized admin UIDs
    match /admins/{adminId} {
      // User can check their own admin status, or verified admins can list all
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      // Only existing admins can add or remove admin accounts
      allow write: if isAdmin();
    }

    // --- Products Collection ---
    // Visitors and customers: READ only (public storefront access without login)
    // Admins only: CREATE, UPDATE, DELETE
    // Normal authenticated users: DENIED write
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- Categories Collection ---
    // Visitors and customers: READ only (public storefront access without login)
    // Admins only: CREATE, UPDATE, DELETE
    // Normal authenticated users: DENIED write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- Orders Collection ---
    // Customers / Guests: CAN ONLY CREATE with strict field, status, and price validation
    // Customers / Normal users: CANNOT READ arbitrary orders, CANNOT UPDATE, CANNOT DELETE
    // Admins: Full management access (read, update status, delete)
    match /orders/{orderId} {
      allow create: if isValidOrder() || isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // --- Order Strict Validation & Anti-Tampering ---
    function isValidOrder() {
      let data = request.resource.data;
      let allowedKeys = [
        'customer', 'phone', 'wilaya', 'commune', 'address',
        'items', 'total', 'paymentMethod', 'status', 'createdAt'
      ];

      return data.keys().hasOnly(allowedKeys)
        // Customer Name: 3 to 100 characters
        && data.customer is string 
        && data.customer.size() >= 3 
        && data.customer.size() <= 100

        // Algerian Phone Number: Exactly 10 digits starting with 05, 06, or 07
        && data.phone is string 
        && data.phone.matches('^0[5-7][0-9]{8}$')

        // Location Info
        && data.wilaya is string && data.wilaya.size() >= 2 && data.wilaya.size() <= 50
        && data.commune is string && data.commune.size() >= 2 && data.commune.size() <= 50
        && data.address is string && data.address.size() <= 200

        // Business Logic & Anti-Tampering:
        // Status MUST strictly be 'جديد' (prevents customer forging status to 'مؤكد' or 'تم التوصيل')
        && data.status == 'جديد'
        && data.paymentMethod == 'الدفع عند الاستلام'
        && data.createdAt is string

        // Items list validation
        && data.items is list 
        && data.items.size() > 0 
        && data.items.size() <= 20

        // Price verification against database source of truth
        && data.total is number 
        && data.total > 0
        && validateOrderPricing();
    }

    function validateOrderPricing() {
      return request.resource.data.items.size() == 1
        ? validateSingleItemOrderPrice()
        : request.resource.data.total > 0;
    }

    // Enforce that single-item orders match the authentic product price in Firestore
    function validateSingleItemOrderPrice() {
      let item = request.resource.data.items[0];
      let quantity = item.keys().hasAll(['quantity']) ? item.quantity : (item.keys().hasAll(['qty']) ? item.qty : 0);
      return item.productId is string
        && item.price is number && item.price > 0
        && quantity is number && quantity >= 1 && quantity <= 50
        // Check product exists in Firestore
        && exists(/databases/$(database)/documents/products/$(item.productId))
        // Verify client price exactly matches Firestore stored price
        && item.price == get(/databases/$(database)/documents/products/$(item.productId)).data.price
        // Verify total matches price * quantity
        && request.resource.data.total == item.price * quantity;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
