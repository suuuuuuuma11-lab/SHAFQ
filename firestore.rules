rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. المنتجات والتصنيفات: قراءة للجميع (المتجر والزوار)، والإدارة للمدير المصادق عليه
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. المشرفين
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }

    // 3. الطلبات: السماح لجميع الزبائن بإنشاء الطلبات (create) دون الحاجة لتسجيل دخول،
    // بينما القراءة والتعديل والحذف محصورة في إدارة المتجر المسجلة فقط
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // حظر أي وصول غير معرّف
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
