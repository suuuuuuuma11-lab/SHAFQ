rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Authentication & Strict Admin Authorization ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verified Admin ONLY via Firebase Custom Claims OR provisioned /admins/{uid} document.
    // Self-registration or arbitrary authenticated users are NEVER granted admin access.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true
        || request.auth.token.role == 'admin'
        || (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active != false
        )
      );
    }

    // --- Admins Collection ---
    // Users may read only their own admin record to verify access; admins may read all.
    // Client writes are strictly denied — admin records must be provisioned via Firebase Console or Admin SDK.
    match /admins/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      allow write: if false;
    }

    // --- Products Collection ---
    // Public catalog read; Admin-only mutations.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- Categories Collection ---
    // Public catalog read; Admin-only mutations.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- Shipping Settings Collection ---
    // Public shipping rate read; Admin-only mutations.
    match /shippingSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Orders Collection ---
    // Client-side direct writes and reads are DENIED to prevent price/shipping tampering
    // and exposure of customer PII.
    // Customer orders are verified and created strictly server-side by /api/order
    // using the Firebase Service Account (Admin SDK permissions).
    // Authenticated Admins have full management access (read, status updates, delete).
    match /orders/{orderId} {
      allow read, create, update, delete: if isAdmin();
    }

    // --- Telegram Notification Queue & Concurrency Lock ---
    // Contains customer PII and internal lock state.
    // ZERO client/public access; accessed strictly server-side via Service Account.
    match /telegramQueue/{docId} {
      allow read, write: if false;
    }

    match /queueControl/{docId} {
      allow read, write: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
