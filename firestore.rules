rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // المنتجات: القراءة متاحة للجميع (المتجر والزوار)، التعديل والإضافة والحذف للمدير المسجل فقط
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // التصنيفات: القراءة متاحة للجميع، التعديل والإضافة والحذف للمدير المسجل فقط
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // الطلبات: السماح للعملاء بإنشاء طلبات مع التحقق من الحقول الأساسية،
    // والقراءة والتحديث والحذف محصورة في المدير المصادق عليه فقط
    match /orders/{orderId} {
      allow create: if request.resource.data.customer is string 
                    && request.resource.data.phone is string 
                    && request.resource.data.items is list;
      allow read, update, delete: if request.auth != null;
    }

    // حظر أي وصول غير معرّف بشكل صريح
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
